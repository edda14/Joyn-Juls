      "id": "bfce1041-fcde-4ca4-9586-d6adb02cb2d2",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Converts the structured AI response and original email metadata into\n * the task format expected by the Join Kanban board.\n */\nconst aiResult = $input.first().json.output;\nconst emailData = $('Extract Email Data').first().json;\n\nconst allowedCategories = ['Technical Task', 'User Story', 'Bug'];\nconst allowedPriorities = ['urgent', 'medium', 'low'];\n\nconst senderName =\n  (emailData.sender || '')\n    .replace(/<[^>]+>/g, '')\n    .trim()\n    .replace(/^[\"']+|[\"']+$/g, '')\n    .trim() ||\n  (emailData.senderEmail || '').split('@')[0] ||\n  'External Stakeholder';\n\nconst deadline =\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(aiResult.deadline || '')\n    ? aiResult.deadline\n    : '';\n\nreturn [{\n  json: {\n    title: String(aiResult.title || emailData.subject || 'New request')\n      .trim()\n      .slice(0, 60),\n    description: String(aiResult.description || '').trim(),\n    assignedTo: [],\n    date: deadline,\n    prio: allowedPriorities.includes(aiResult.priority)\n      ? aiResult.priority\n      : 'medium',\n    category: allowedCategories.includes(aiResult.category)\n      ? aiResult.category\n      : 'Technical Task',\n    subcategory: [],\n    completedSubtasks: [],\n    status: 'triage',\n    creator: {\n      type: 'external',\n      role: 'stakeholder',\n      name: senderName,\n      email: emailData.senderEmail\n    },\n    source: 'email',\n    aiGenerated: true,\n    createdAt: new Date().toISOString(),\n    messageId: emailData.messageId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

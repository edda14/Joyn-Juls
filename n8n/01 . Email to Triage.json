      "id": "bfce1041-fcde-4ca4-9586-d6adb02cb2d2",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Converts the structured AI response and original email metadata into\n * the task format expected by the Join Kanban board.\n */\nconst aiResult = $input.first().json.output || {};\nconst requestData = $('Check Daily Limit').first().json;\n\nconst userPrio = requestData.prio || requestData.priority;\n\nconst allowedCategories = ['Technical Task', 'User Story', 'Bug'];\nconst allowedPriorities = ['urgent', 'medium', 'low'];\n\nconst finalPrio = allowedPriorities.includes(userPrio)\n  ? userPrio\n  : (allowedPriorities.includes(aiResult.priority) ? aiResult.priority : 'medium');\n\nconst senderName =\n  (requestData.sender || '')\n    .replace(/<[^>]+>/g, '')\n    .trim()\n    .replace(/^[\"']+|[\"']+$/g, '')\n    .trim() ||\n  (requestData.senderEmail || '').split('@')[0] ||\n  'External Stakeholder';\n\nconst deadline =\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(aiResult.deadline || '')\n    ? aiResult.deadline\n    : '';\n\n// Subtasks aus der KI verarbeiten und als reine Strings formatieren\nconst rawSubtasks = Array.isArray(aiResult.subtasks) ? aiResult.subtasks : [];\nconst subcategoryStrings = rawSubtasks.map(t => String(t).trim()).filter(Boolean);\nconst subtaskCompletedStrings = subcategoryStrings.map(() => 'false');\n\nreturn [{\n  json: {\n    title: String(aiResult.title || requestData.subject || 'New request')\n      .trim()\n      .slice(0, 60),\n    description: String(aiResult.description || '').trim(),\n    assignedTo: [],\n    date: deadline,\n    prio: finalPrio,\n    category: allowedCategories.includes(aiResult.category)\n      ? aiResult.category\n      : 'Technical Task',\n    subcategory: subcategoryStrings,        // -> Array aus Strings: [\"Schritt 1\", \"Schritt 2\"]\n    completedSubtasks: subtaskCompletedStrings, // -> Array aus Strings: [\"false\", \"false\"]\n    status: 'triage',\n    creator: {\n      type: 'external',\n      role: 'stakeholder',\n      name: senderName,\n      email: requestData.senderEmail\n    },\n    source: requestData.source || 'form',\n    aiGenerated: true,\n    createdAt: new Date().toISOString(),\n    messageId: requestData.messageId || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

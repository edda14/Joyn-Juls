    {
      "parameters": {
        "jsCode": "/**\n * Counts all accepted requests for the current day and preserves the\n * normalized email data for the following workflow branches.\n */\nconst requestsToday = $input\n  .all()\n  .filter(item => item.json.id)\n  .length;\n\nconst emailData = $('Extract Email Data').first().json;\nconst dailyLimit = 10;\n\nreturn [{\n  json: {\n    ...emailData,\n    requestsToday,\n    dailyLimit,\n    limitReached: requestsToday >= dailyLimit,\n  },\n}];"
      },

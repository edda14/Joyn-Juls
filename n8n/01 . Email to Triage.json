    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"title\": \"Login-Fehler beheben\",\n  \"description\": \"Der Login schlägt bei bestehenden Konten fehl. Dieses Ticket wurde KI-generiert.\",\n  \"category\": \"Bug\",\n  \"priority\": \"urgent\",\n  \"deadline\": \"\"\n}"
      },

    {
      "parameters": {
        "jsCode": "/**\n * Creates the public daily request counter response.\n */\nconst requests = $input\n  .all()\n  .filter((item) => item.json && item.json.id);\n\nconst limit = 10;\nconst used = Math.min(requests.length, limit);\n\nreturn [\n  {\n    json: {\n      used,\n      limit,\n      remaining: Math.max(limit - used, 0),\n      limitReached: used >= limit,\n    },\n  },\n];"
      },

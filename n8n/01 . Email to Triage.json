    {
      "parameters": {
        "jsCode": "/**\n * Counts today's requests and keeps the normalized request data.\n * Supports requests received through Gmail and the stakeholder form.\n */\nconst formUsed = $('Prepare Form Data').isExecuted;\nconst requestData = formUsed\n  ? $('Prepare Form Data').first().json\n  : $('Extract Email Data').first().json;\n\nconst requestsToday = $input\n  .all()\n  .filter(item => item.json.id)\n  .length;\n\nconst dailyLimit = 10;\n\nreturn [{\n  json: {\n    ...requestData,\n    requestsToday,\n    dailyLimit,\n    limitReached: requestsToday >= dailyLimit,\n  },\n}];"
      },
